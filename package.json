{
  "name": "bee-linux",
  "version": "0.5.2",
  "description": "bee-linux: the agent of Beekeeper for Linux servers (monitoring, checks, updates, console, AI access). Install: sudo npx bee-linux@latest install",
  "author": "ioSofting GmbH",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://beekeeper.one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioSofting/bee-linux.git"
  },
  "keywords": [
    "beekeeper",
    "monitoring",
    "linux",
    "agent",
    "fleet"
  ],
  "type": "module",
  "bin": {
    "bee-linux": "dist/cli.cjs"
  },
  "files": [
    "dist/bee-linux.cjs",
    "dist/cli.cjs",
    "bee-root",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:agent && npm run build:cli",
    "build:agent": "esbuild src/main.ts --bundle --platform=node --target=node18 --format=cjs --legal-comments=none --external:bufferutil --external:utf-8-validate --outfile=dist/bee-linux.cjs",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --legal-comments=none --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.cjs",
    "check-ts": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "mqtt": "^5.16.0",
    "ws": "^8.22.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
