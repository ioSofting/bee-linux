  "private": true,
  "description": "bee-linux: the agent of beekeeper for Linux servers (monitoring, checks, updates, console)",
  "author": "ioSofting GmbH",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=18"
